[Unit]
Description=Elavo screen lock and display sleep when idle
Documentation=https://github.com/elavo-io/elavo-system-settings
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
ConditionEnvironment=XDG_CURRENT_DESKTOP=elavo

[Service]
# Reads ~/.config/elavo/idle.conf, which System Settings' Lock Screen pane
# writes; System Settings restarts this unit after a change.
ExecStart=/usr/libexec/elavo-idle
Restart=on-failure
RestartSec=1
Slice=session.slice

[Install]
WantedBy=graphical-session.target
