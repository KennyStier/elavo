[Unit]
Description=Elavo administrator password prompts (polkit agent)
# Without an agent, pkexec and D-Bus calls that need an administrator fail
# instead of asking: System Settings' updates, users, date and time, and
# the computer's name.
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
ConditionEnvironment=XDG_CURRENT_DESKTOP=elavo

[Service]
ExecStart=/usr/libexec/polkit-mate-authentication-agent-1
Restart=on-failure
RestartSec=1
Slice=session.slice

[Install]
WantedBy=graphical-session.target
