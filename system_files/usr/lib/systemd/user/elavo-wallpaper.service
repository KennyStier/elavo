[Unit]
Description=Elavo desktop wallpaper
Documentation=https://github.com/elavo-io/elavo-system-settings
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
ConditionEnvironment=XDG_CURRENT_DESKTOP=elavo

[Service]
# Reads ~/.config/elavo/wallpaper.conf, which System Settings' Wallpaper pane
# writes. System Settings restarts this unit after a change. The process also
# watches the color scheme so Automatic can switch light and dark.
ExecStart=/usr/libexec/elavo-wallpaper
Restart=on-failure
RestartSec=1
Slice=session.slice

[Install]
WantedBy=graphical-session.target
