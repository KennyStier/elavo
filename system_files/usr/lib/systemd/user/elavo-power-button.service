[Unit]
Description=Elavo power button
PartOf=graphical-session.target
After=graphical-session.target elavo-panel.service
Requisite=graphical-session.target
ConditionEnvironment=XDG_CURRENT_DESKTOP=elavo

[Service]
# The inhibitor stops logind from powering off on a press. The program
# asks the panel to show its Shut Down question, or turns the screen on.
ExecStart=/usr/bin/systemd-inhibit --what=handle-power-key --who=Elavo --why=PowerButton --mode=block /usr/libexec/elavo-power-button
Restart=on-failure
RestartSec=1
Slice=session.slice

[Install]
WantedBy=graphical-session.target
