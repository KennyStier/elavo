[Unit]
Description=Elavo title bars follow the color scheme
Documentation=file:///usr/share/themes/Elavo/README.md
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
ConditionEnvironment=XDG_CURRENT_DESKTOP=elavo

[Service]
ExecStart=/usr/libexec/elavo-labwc-theme
Restart=on-failure
RestartSec=1
Slice=session.slice

[Install]
WantedBy=graphical-session.target
